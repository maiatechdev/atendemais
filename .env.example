# Conexao com o MariaDB/MySQL criado no hPanel da Hostinger
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
# Se o app rodar na mesma VPS do banco, use HOST=localhost
DATABASE_URL="mysql://usuario_banco:senha_banco@localhost:3306/nome_do_banco"

# Porta em que o server.js vai escutar (a VPS/Nginx faz proxy para ela)
PORT=3001

# Necessario em produção: ativa o modo de build estatico e desativa o Vite middleware
NODE_ENV=production

# Opcional: restringe o CORS do socket.io a um dominio especifico.
# Deixe vazio/comentado se frontend e backend forem servidos pelo mesmo dominio (recomendado na VPS).
# FRONTEND_URL=https://seudominio.com.br

# Necessaria para liberar a API REST de integracao externa (GET /api/integracoes/agendamentos).
# Sem essa variavel definida, as rotas ficam bloqueadas (503). Gere uma chave aleatoria longa,
# ex: openssl rand -hex 32, e entregue apenas essa chave ao sistema/desenvolvedor externo.
# EXTERNAL_API_KEY=
