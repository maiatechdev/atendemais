# Conexao com o MariaDB/MySQL.
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
# Na VM de producao o banco roda na propria maquina: use HOST=127.0.0.1 (TCP), nao localhost.
# Gere a senha so com letras e numeros (ex: openssl rand -hex 20), pois caracteres como @ : / # %
# quebram a URL.
DATABASE_URL="mysql://usuario_banco:senha_banco@127.0.0.1:3306/nome_do_banco"

# Porta em que o server.js vai escutar. O Nginx da VM faz proxy para ela; nao abra no firewall.
PORT=3001

# Necessario em producao: ativa o modo de build estatico e desativa o Vite middleware.
NODE_ENV=production

# Restringe o CORS do socket.io ao dominio do Atende+. Em producao, preencha com o dominio real.
# FRONTEND_URL=https://atendemais.seudominio.gov.br

# Necessaria para liberar a API REST de integracao externa (GET /api/integracoes/agendamentos).
# Sem essa variavel definida, as rotas ficam bloqueadas (503). Gere uma chave aleatoria longa,
# ex: openssl rand -hex 32, e entregue apenas essa chave ao sistema/desenvolvedor externo.
# EXTERNAL_API_KEY=

# Observacao: o server.js nao usa dotenv. Este arquivo e carregado pela flag --env-file=.env
# (definida no ecosystem.config.cjs do PM2). Reinicie o app apos qualquer alteracao.
